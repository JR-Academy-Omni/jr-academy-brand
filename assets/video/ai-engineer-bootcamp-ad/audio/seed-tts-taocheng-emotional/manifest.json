      "sha256": "a089e7123e7cf386e9d4fad37e950f7197a580b62385e04f618c06f4fa5d0810"
    },
    {
      "id": "02",
      "text": "但真正决定它能不能成为产品的，是屏幕后面整套 AI 系统。",
      "start": 3,
      "end": 7.4,
      "speechRate": 8,
      "loudnessRate": 1,
      "deliveryTempo": 1.12,
      "direction": "从克制开始明显打开，带发现感和推进感。强调“真正决定”“成为产品”和“整套 AI 系统”。",
      "filename": "02.mp3",
      "bytes": 38829,
      "sha256": "9f928be120b1fb0146904dfed82317d5cafdef23b765c7449de33db796e055ac"
    },
    {
      "id": "03",
      "text": "Context 要装得准确，RAG 要找到证据，Agent 必须在关键时刻，调用正确的工具。",
      "start": 8,
      "end": 14.25,
      "speechRate": 17,
      "loudnessRate": 4,
      "deliveryTempo": 1.3,
      "direction": "节奏加快，像系统逐层点亮。Context、RAG、Agent 分别加重；“必须在关键时刻”要有紧迫感，结尾坚定。",
      "filename": "03.mp3",
      "bytes": 45741,
      "sha256": "459bb513aee01a7fc1524424ab453787e2928493db244835384d7baba51402ab"
    },
    {
      "id": "04",
      "text": "而把模型、数据和工具，真正变成产品的人——就是 AI Engineer。",
      "start": 15,
      "end": 19.75,
      "speechRate": 5,
      "loudnessRate": 10,
      "deliveryTempo": 1.22,
      "direction": "这是第一次情绪爆发。前半句蓄力，在“人”之后做有力停顿；“就是 AI Engineer”像揭晓主角身份，昂扬、坚定、令人振奋。",
      "filename": "04.mp3",
      "bytes": 42861,
      "sha256": "18d7daea1c561aa88e330ede4188cac72c90c514451cac65e4d89d727e18548b"
    },
    {
      "id": "05",
      "text": "会调用 API，只是开始。让 AI 稳定、可信、真正交付，才是这个时代稀缺的工程能力。",
      "start": 20,
      "end": 25.8,
      "speechRate": 19,
      "loudnessRate": 7,
      "deliveryTempo": 1.08,
      "direction": "保持高能量但不喊叫。“只是开始”短促停顿；稳定、可信、真正交付逐级加重，在“这个时代稀缺”上给出价值感。",
      "filename": "05.mp3",
      "bytes": 48813,
      "sha256": "7f6642ab0f294fec61ca82b19d3ca21e283d435ef3b101e657df0586469e8ed4"
    },
    {
      "id": "06",
      "text": "在匠人学院，用三个月、上百节课和真实项目，从 Context、RAG、MCP，一路做到 Agent、Multi-Agent 与 Evals。",
      "start": 26,
      "end": 33.55,
      "speechRate": 20,
      "loudnessRate": 8,
      "deliveryTempo": 1,
      "direction": "明亮、自信、速度略快，像正式发布一条清晰的成长路径。“三个月、上百节课、真实项目”有节奏地递进，最后一路向上。",
      "filename": "06.mp3",
      "bytes": 68589,
      "sha256": "efb98723bb2f6486f967467ee3da306bf7fd41a178cf92589d7241761521cc64"
    },
    {
