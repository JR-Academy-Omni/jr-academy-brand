    {
      "id": "04",
      "text": "而负责把模型、数据和工具变成产品的岗位，叫 AI Engineer。",
      "start": 15,
      "end": 19.75,
      "speechRate": 0,
      "loudnessRate": 6,
      "deliveryTempo": 1.22,
